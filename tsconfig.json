{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Sửa/Thêm dòng này thay cho Node truyền thống */
    "moduleResolution": "Bundler", 
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Bỏ dòng "baseUrl": "." đi và sửa paths thành ./src như dưới đây */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}